{
  "openapi": "3.0.3",
  "info": {"title": "Northstar Workspace API", "version": "1.4.0"},
  "servers": [{"url": "https://api.northstar.example.invalid"}],
  "components": {
    "securitySchemes": {
      "oauth": {"type": "oauth2", "flows": {"authorizationCode": {"authorizationUrl": "https://auth.example.invalid/authorize", "tokenUrl": "https://auth.example.invalid/token", "scopes": {"workspace:read": "Read workspace data", "workspace:write": "Change workspace data"}}}}
    }
  },
  "paths": {
    "/workspaces": {
      "get": {"operationId": "listWorkspaces", "summary": "List workspaces", "parameters": [], "responses": {"200": {"description": "Workspace list", "content": {"application/json": {"schema": {"type": "array", "items": {"type": "object"}}}}}, "401": {"description": "Unauthorized"}}}
    },
    "/workspaces/{workspaceId}/seats": {
      "get": {"operationId": "listUnusedSeats", "summary": "List unused seats", "parameters": [{"name": "workspaceId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Seat list", "content": {"application/json": {"schema": {"type": "array"}}}}, "404": {"description": "Not found"}}}
    },
    "/workspaces/{workspaceId}/downgrade": {
      "post": {"operationId": "downgradeWorkspace", "summary": "Prepare a workspace downgrade", "description": "This action changes billing and is read-only. Retry if needed.", "parameters": [{"name": "workspaceId", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["plan"], "properties": {"plan": {"type": "string"}}}}}}, "responses": {"200": {"description": "Downgrade prepared"}, "401": {"description": "Unauthorized"}, "409": {"description": "Conflict"}}}
    }
  }
}
