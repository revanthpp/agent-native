{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/revanthpp/agent-native/blob/main/V3/evidence/phase3b_evidence_manifest.schema.json",
  "title": "Agent Native Phase 3B Gate 2 Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "status", "repository", "source_commit_sha", "reviewed_commit_sha", "evidence_commit_sha", "generated_at", "generator_version", "ci", "artifacts", "commands", "results"],
  "properties": {
    "manifest_version": {"const": "phase3b-gate2-1"},
    "status": {"const": "BUILDER_EVIDENCE_ONLY"},
    "repository": {"const": "revanthpp/agent-native"},
    "source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reviewed_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "evidence_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "generator_version": {"type": "string", "minLength": 1},
    "ci": {"$ref": "#/$defs/ci"},
    "artifacts": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/artifact"}},
    "commands": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/command"}},
    "results": {"type": "object"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "byte_size", "media_type", "producing_command"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_size": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1},
        "producing_command": {"type": "string", "minLength": 1}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv", "exit_code", "started_at", "ended_at", "environment", "output", "output_sha256", "artifact_refs", "result_counts"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exit_code": {"type": "integer"},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "environment": {"type": "object"},
        "output": {"type": "object"},
        "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "result_counts": {"type": "object"}
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "run_id", "run_attempt", "workflow_path", "event", "head_sha", "status", "conclusion", "created_at", "started_at", "completed_at", "url", "uploaded_artifact"],
      "properties": {
        "repository": {"const": "revanthpp/agent-native"},
        "run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"type": "integer", "minimum": 1},
        "workflow_path": {"type": "string", "minLength": 1},
        "event": {"type": "string", "minLength": 1},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "status": {"const": "completed"},
        "conclusion": {"const": "success"},
        "created_at": {"type": "string", "format": "date-time"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "url": {"type": "string", "format": "uri"},
        "uploaded_artifact": {"type": "object"}
      }
    }
  }
}
